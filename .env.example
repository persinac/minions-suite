# Copy to .env and fill in values.
# When running via docker compose, hostnames "postgres" and "nats" resolve
# to the containers defined in docker-compose.yml.
# For local (non-Docker) dev, replace with localhost equivalents.

# ── LLM ───────────────────────────────────────────────────────────────────────
LITELLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Alternatively, for OpenAI:
# LITELLM_MODEL=gpt-4o
# OPENAI_API_KEY=

# ── Git Provider ───────────────────────────────────────────────────────────────
GIT_PROVIDER=gitlab
GITLAB_URL=https://gitlab.yourcompany.com
GITLAB_TOKEN=

# Optional GitHub support:
# GH_TOKEN=

# ── Database ───────────────────────────────────────────────────────────────────
DB_BACKEND=postgres
# Admin URL used by init-infra (container-to-container)
POSTGRES_ADMIN_URL=postgresql://minion:minion@postgres:5432/minion
# Host-side URL for running migrations from outside Docker (task db:migrate)
POSTGRES_MIGRATE_URL=postgresql://minion:minion@localhost:5434/minion?sslmode=disable
# App URL — update to use minion_app after running init-infra
# Inside Docker: port 5432 (container-to-container). From host: port 6432.
POSTGRES_URL=postgresql://minion_app:<app-password>@postgres:5432/minion
# Password for the minion_app role (used by init-infra to create it)
PG_APP_PASSWORD=

# ── NATS ───────────────────────────────────────────────────────────────────────
NATS_ENABLED=true
# Docker service hostname is "nats"
NATS_SERVER_IP=nats://nats:4222

# ── Arbiter (State Control Plane) ────────────────────────────────────────────
# Centralized state transition validation, heartbeat monitoring, anomaly detection.
# Requires NATS_ENABLED=true and DB_BACKEND=postgres.
ARBITER_ENABLED=true

# ── MCP Server ─────────────────────────────────────────────────────────────────
MCP_PORT=8321
# Must be 0.0.0.0 inside Docker so the port is reachable from the host
MCP_HOST=0.0.0.0

# ── Review Engine ──────────────────────────────────────────────────────────────
MAX_CONCURRENT_REVIEWS=3
MAX_CONCURRENT_JOBS=3
MAX_REVISIONS=3
AGENT_TIMEOUT=600
# DRY_RUN=true            # Log actions without executing (git pushes, PR creation, etc.)

# ── Input Sources ────────────────────────────────────────────────────────────
# Each source is opt-in. Leave keys empty or ENABLED=false to skip — the
# system starts normally and ignores unconfigured sources.

# GitLab Issues Poller — creates jobs from GitLab issues with a specific label.
# Requires GITLAB_TOKEN (set above). Skips if ENABLED is not true.
GITLAB_ISSUES_ENABLED=true
GITLAB_ISSUES_POLL_INTERVAL=120

# Trello Poller — creates jobs from Trello board cards.
# Only active when running `--trello-only` or when keys are set in --server mode
# (enables Trello comments on job progress + tech debt card creation).
# Skips gracefully if keys are empty.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_POLL_INTERVAL=180

# Renovate Engine — auto-merge low-risk dependency updates.
# RENOVATE_ENABLED=true
# RENOVATE_POLL_INTERVAL=60
# RENOVATE_MAX_CONCURRENT=2

# ── LangGraph (experimental) ────────────────────────────────────────────────
USE_LANGGRAPH_AGENT=true    # Use LangGraph subgraph for agent execution
USE_LANGGRAPH_ENGINE=true   # Use LangGraph graph for job orchestration

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

PROJECTS_FILE=projects.local.yaml

# ── S3 Artifact Upload (optional) ────────────────────────────────────────────
# Upload agent logs and review artifacts to S3. Skips if bucket is empty.
# S3_ARTIFACT_BUCKET=my-minion-artifacts
# S3_ARTIFACT_REGION=us-east-1
# S3_ARTIFACT_PREFIX=minions
# AWS_PROFILE_NAME=mcp-minions

# ── Memory System (agent-memory) ──────────────────────────────────────────────
MEMORY_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
MEMORY_L3_TOKEN_BUDGET=2000
# Set to DEBUG to see tier-level trace logs (retrieval scoring, archival, etc.)
MEMORY_LOG_LEVEL=INFO

# ── Langfuse (optional, LLM observability) ──────────────────────────────────
# Set LANGFUSE_PUBLIC_KEY to enable tracing. Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# OTEL endpoint — Langfuse Cloud default; override for self-hosted
LANGFUSE_OTEL_HOST=https://cloud.langfuse.com
# Self-hosted: docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up -d
# Then create a project at http://localhost:3000 and paste the keys above.
# Set LANGFUSE_OTEL_HOST=http://langfuse:3000 (container-to-container)